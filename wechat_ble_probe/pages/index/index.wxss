.page {
  padding: 32rpx;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.eyebrow,
.title,
.summary-label,
.summary-value,
.section-title,
.section-note,
.metric-label,
.metric-value,
.unit,
.ppb-state,
.last-message,
.log-time,
.log-message {
  display: block;
  letter-spacing: 0;
}

.eyebrow {
  color: #6c7470;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 280rpx;
  color: #5e6662;
  font-size: 22rpx;
  text-align: right;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #939b97;
  flex: 0 0 auto;
}

.status-working .status-dot {
  background: #d59a28;
}

.status-success .status-dot {
  background: #17866b;
}

.status-error .status-dot {
  background: #bd4a4a;
}

.toolbar {
  display: grid;
  grid-template-columns: 1fr 180rpx;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.primary,
.secondary,
.clear {
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
}

.primary {
  background: #151716;
  color: #fff;
}

.secondary {
  background: #fff;
  color: #151716;
  border: 1rpx solid #d8ddda;
}

.clear {
  background: transparent;
  color: #56605b;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  line-height: 1.5;
}

.summary,
.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1rpx solid #dfe3e1;
  background: #fff;
  border-radius: 8rpx;
  overflow: hidden;
}

.summary {
  margin-bottom: 36rpx;
}

.summary-item,
.metric {
  padding: 24rpx;
  min-width: 0;
}

.summary-item + .summary-item,
.metric:nth-child(even) {
  border-left: 1rpx solid #e5e8e6;
}

.summary-label,
.metric-label {
  color: #737b77;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
}

.summary-value.compact {
  font-size: 26rpx;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-note,
.last-message {
  color: #7a827e;
  font-size: 21rpx;
}

.metrics {
  margin-bottom: 36rpx;
}

.metric {
  border-bottom: 1rpx solid #e5e8e6;
}

.metric.wide {
  grid-column: 1 / 3;
  border-bottom: 0;
  border-left: 0;
}

.metric-value {
  display: inline;
  font-size: 34rpx;
  font-weight: 700;
}

.unit {
  display: inline;
  color: #707873;
  font-size: 21rpx;
}

.ppb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ppb-state {
  color: #14775f;
  font-size: 23rpx;
  font-weight: 600;
}

.logs-heading {
  align-items: center;
}

.last-message {
  margin-top: 6rpx;
  max-width: 540rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logs {
  border-top: 1rpx solid #dfe3e1;
  background: #fff;
}

.log-row {
  display: grid;
  grid-template-columns: 126rpx 1fr;
  gap: 18rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #ecefed;
}

.log-time {
  color: #8b928f;
  font-family: monospace;
  font-size: 20rpx;
}

.log-message {
  color: #303532;
  font-family: monospace;
  font-size: 21rpx;
  word-break: break-all;
}

.empty {
  color: #7b837f;
  font-size: 23rpx;
  padding: 42rpx 4rpx;
}
