.home-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f5f8fa;
}

.home-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.theme-hit {
  position: absolute;
  z-index: 4;
  top: 45%;
  left: 10%;
  width: 80%;
  height: 6.5%;
  border-radius: 50rpx;
}

.nav-hit {
  position: absolute;
  z-index: 2;
  bottom: 3.8%;
  width: 15%;
  height: 8.2%;
  border-radius: 50%;
}

.nav-home {
  left: 9.2%;
}

.nav-report {
  left: 25.4%;
}

.nav-training {
  bottom: 2.5%;
  left: 39%;
  width: 22%;
  height: 11%;
  transition: transform 180ms ease;
}

.nav-training.pressed {
  transform: scale(0.93);
}

.nav-favorite {
  right: 25.4%;
}

.nav-profile {
  right: 9.2%;
}

.start-ripple {
  position: absolute;
  inset: 5%;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  animation: ripple 600ms ease-out infinite;
}

.theme-backdrop {
  position: absolute;
  z-index: 8;
  inset: 0;
  background: rgba(245, 248, 250, 0.04);
}

.theme-card {
  position: absolute;
  top: 45.6%;
  left: 10.5%;
  box-sizing: border-box;
  width: 79%;
  padding: 0 38rpx 38rpx;
  border-radius: 0 0 44rpx 44rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 42rpx rgba(45, 49, 72, 0.22);
}

.theme-card-title {
  height: 82rpx;
  margin: 0 -38rpx 34rpx;
  border-radius: 48rpx;
  background: #f5f8fa;
  color: #3097ed;
  font-size: 30rpx;
  line-height: 82rpx;
  text-align: center;
}

.theme-arrow {
  margin-left: 10rpx;
  font-size: 22rpx;
}

.theme-grid {
  position: relative;
  height: 310rpx;
  overflow: hidden;
  border-radius: 58rpx;
  background: #e9ecff;
}

.grid-line {
  position: absolute;
  background: #d8ddff;
}

.grid-line.vertical {
  top: 50rpx;
  bottom: 50rpx;
  width: 3rpx;
}

.v1 { left: 20%; }
.v2 { left: 35%; }
.v3 { left: 50%; }
.v4 { left: 65%; }
.v5 { left: 80%; }

.grid-line.horizontal {
  right: 15%;
  left: 15%;
  height: 3rpx;
}

.h1 { top: 25%; }
.h2 { top: 42%; }
.h3 { top: 59%; }
.h4 { top: 76%; }

.axis-label {
  position: absolute;
  z-index: 2;
  color: #7b82ff;
  font-size: 20rpx;
  line-height: 1;
}

.peaceful { top: 18rpx; left: 9%; }
.bright { top: 18rpx; left: 44%; }
.energetic { top: 18rpx; right: 8%; }
.somber { bottom: 18rpx; left: 9%; }
.deep { bottom: 18rpx; left: 46%; }
.intense { right: 8%; bottom: 18rpx; }

.theme-dot {
  position: absolute;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
  margin: -21rpx 0 0 -21rpx;
  border-radius: 50%;
  background: #737cff;
  box-shadow: 0 6rpx 14rpx rgba(96, 105, 231, 0.28);
}

.confirm-theme {
  width: 250rpx;
  margin: 34rpx auto 0;
  padding: 13rpx 20rpx;
  border-radius: 46rpx;
  background: linear-gradient(100deg, #7780ff, #969aff);
  box-shadow: 0 12rpx 24rpx rgba(119, 128, 255, 0.28);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.5;
}

.confirm-theme::after {
  border: 0;
}

.onboarding-backdrop {
  position: absolute;
  z-index: 12;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 84rpx 30rpx 34rpx;
  background: rgba(28, 30, 38, 0.52);
  backdrop-filter: blur(2rpx);
}

.assessment-card {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 48rpx 54rpx 42rpx;
  overflow-y: auto;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 80rpx rgba(18, 20, 31, 0.24);
}

.assessment-kicker {
  color: #7b82ff;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.35;
}

.assessment-title {
  margin-top: 54rpx;
  color: #111217;
  font-size: 34rpx;
  font-weight: 780;
  text-align: center;
}

.assessment-copy {
  margin: 34rpx 12rpx 38rpx;
  color: #8c8d91;
  font-size: 23rpx;
  line-height: 1.42;
}

.assessment-item {
  display: grid;
  grid-template-columns: 74rpx 1fr;
  align-items: center;
  gap: 18rpx;
  min-height: 116rpx;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  background: #f5f7f8;
  color: #898a8e;
  font-size: 22rpx;
  line-height: 1.38;
}

.assessment-icon {
  color: #898a8e;
  font-size: 48rpx;
  text-align: center;
}

.muted-icon {
  transform: rotate(-40deg);
}

.assessment-start {
  width: 280rpx;
  margin: 40rpx auto 0;
  padding: 17rpx 20rpx;
  border-radius: 52rpx;
  background: linear-gradient(100deg, #7b82ff, #9d9fff);
  box-shadow: 0 14rpx 28rpx rgba(123, 130, 255, 0.3);
  color: #ffffff;
  font-size: 28rpx;
}

.assessment-start::after {
  border: 0;
}

@keyframes ripple {
  from {
    transform: scale(0.72);
    opacity: 0.9;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
