.home-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f5f8fa;
}

.home-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.theme-hit {
  position: absolute;
  z-index: 4;
  top: 45%;
  left: 10%;
  width: 80%;
  height: 6.5%;
  border-radius: 50rpx;
}

.nav-hit {
  position: absolute;
  z-index: 2;
  bottom: 3.8%;
  width: 15%;
  height: 8.2%;
  border-radius: 50%;
}

.nav-home {
  left: 9.2%;
}

.nav-report {
  left: 25.4%;
}

.nav-training {
  bottom: 2.5%;
  left: 39%;
  width: 22%;
  height: 11%;
  transition: transform 180ms ease;
}

.nav-training.pressed {
  transform: scale(0.93);
}

.nav-favorite {
  right: 25.4%;
}

.nav-profile {
  right: 9.2%;
}

.start-ripple {
  position: absolute;
  inset: 5%;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  animation: ripple 600ms ease-out infinite;
}

.theme-backdrop {
  position: absolute;
  z-index: 8;
  inset: 0;
  background: rgba(245, 248, 250, 0.04);
}

.theme-card {
  position: absolute;
  top: 45.6%;
  left: 10.5%;
  box-sizing: border-box;
  width: 79%;
  padding: 0 38rpx 38rpx;
  border-radius: 0 0 44rpx 44rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 42rpx rgba(45, 49, 72, 0.22);
}

.theme-card-title {
  height: 82rpx;
  margin: 0 -38rpx 34rpx;
  border-radius: 48rpx;
  background: #f5f8fa;
  color: #3097ed;
  font-size: 30rpx;
  line-height: 82rpx;
  text-align: center;
}

.theme-arrow {
  margin-left: 10rpx;
  font-size: 22rpx;
}

.theme-grid {
  position: relative;
  height: 310rpx;
  overflow: hidden;
  border-radius: 58rpx;
  background: #e9ecff;
}

.grid-line {
  position: absolute;
  background: #d8ddff;
}

.grid-line.vertical {
  top: 50rpx;
  bottom: 50rpx;
  width: 3rpx;
}

.v1 { left: 20%; }
.v2 { left: 35%; }
.v3 { left: 50%; }
.v4 { left: 65%; }
.v5 { left: 80%; }

.grid-line.horizontal {
  right: 15%;
  left: 15%;
  height: 3rpx;
}

.h1 { top: 25%; }
.h2 { top: 42%; }
.h3 { top: 59%; }
.h4 { top: 76%; }

.axis-label {
  position: absolute;
  z-index: 2;
  color: #7b82ff;
  font-size: 20rpx;
  line-height: 1;
}

.peaceful { top: 18rpx; left: 9%; }
.bright { top: 18rpx; left: 44%; }
.energetic { top: 18rpx; right: 8%; }
.somber { bottom: 18rpx; left: 9%; }
.deep { bottom: 18rpx; left: 46%; }
.intense { right: 8%; bottom: 18rpx; }

.theme-dot {
  position: absolute;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
  margin: -21rpx 0 0 -21rpx;
  border-radius: 50%;
  background: #737cff;
  box-shadow: 0 6rpx 14rpx rgba(96, 105, 231, 0.28);
}

.confirm-theme {
  width: 250rpx;
  margin: 34rpx auto 0;
  padding: 13rpx 20rpx;
  border-radius: 46rpx;
  background: linear-gradient(100deg, #7780ff, #969aff);
  box-shadow: 0 12rpx 24rpx rgba(119, 128, 255, 0.28);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.5;
}

.confirm-theme::after {
  border: 0;
}

.onboarding-backdrop {
  position: absolute;
  z-index: 12;
  inset: 0;
  overflow: hidden;
  background: #8d8d8d;
}

.onboarding-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.onboarding-start-hit {
  position: absolute;
  z-index: 13;
  top: 88.5%;
  left: 31%;
  width: 38%;
  height: 7%;
  border-radius: 60rpx;
}

.onboarding-start-hit:active {
  background: rgba(255, 255, 255, 0.12);
}

@keyframes ripple {
  from {
    transform: scale(0.72);
    opacity: 0.9;
  }
  to {
    transform: scale(1.1);
    opacity: 0;
  }
}
