.report-page{box-sizing:border-box;min-height:100vh;padding:104rpx 38rpx 46rpx;background:#f4f7fa;color:#2b2b31}.report-header,.hero-pills,.stepper,.actions{display:flex;align-items:center}.report-header{justify-content:space-between}.title{font-size:44rpx;font-weight:750}.subtitle{margin-top:8rpx;color:#aaa9ad;font-size:23rpx}button::after{border:0}.close-button{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin:0;padding:0;border-radius:50%;background:#fff;color:#7880ff;font-size:38rpx;font-weight:700}.hero{position:relative;min-height:244rpx;margin-top:40rpx;overflow:hidden;border-radius:30rpx;background:#e9ebff}.hero-copy{position:relative;z-index:2;width:62%;padding:48rpx 0 34rpx 40rpx}.hero-title{color:#747cff;font-size:38rpx;font-weight:750}.hero-text{margin-top:18rpx;font-size:24rpx;line-height:1.38}.hero-pills{gap:16rpx;margin-top:30rpx}.pill{min-width:142rpx;padding:12rpx 20rpx;border-radius:34rpx;background:#fff;font-size:22rpx;font-weight:650;text-align:center}.pill.score{color:#747cff}.character-halo{position:absolute;right:-42rpx;bottom:-28rpx;width:280rpx;height:280rpx;border-radius:50%;background:rgba(157,163,255,.26)}.hero-character{position:absolute;z-index:1;right:10rpx;bottom:-22rpx;width:250rpx;height:230rpx}.section-title{margin:48rpx 12rpx 28rpx;font-size:34rpx;font-weight:730}.metric-grid,.threshold-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.metric-card{position:relative;box-sizing:border-box;min-height:230rpx;padding:34rpx;overflow:hidden;border-radius:28rpx;background:#fff}.metric-label{color:#aaa9ad;font-size:25rpx}.metric-value{margin-top:28rpx;font-size:56rpx;font-weight:780;line-height:1}.metric-note{margin-top:38rpx;font-size:22rpx}.metric-dot{position:absolute;top:22rpx;right:22rpx;width:68rpx;height:68rpx;border-radius:50%;opacity:.22;background:currentColor}.green .metric-value,.green .metric-dot{color:#6edc62}.purple .metric-value,.purple .metric-dot{color:#747cff}.blue .metric-value,.blue .metric-dot{color:#62aaff}.yellow .metric-value,.yellow .metric-dot{color:#ffc44f}.threshold-title{margin-top:40rpx}.threshold-card{padding:25rpx 18rpx 20rpx;border-radius:28rpx;background:#fff}.threshold-name{min-height:56rpx;font-size:24rpx;font-weight:680;text-align:center}.stepper{justify-content:space-between;margin-top:8rpx}.step-button{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;margin:0;padding:0;border-radius:50%;font-size:34rpx;font-weight:650}.step-button.minus{background:#f4f6f8;color:#7b82ff}.step-button.plus{background:#747cff;color:#fff}.step-value{text-align:center}.step-value text{font-size:36rpx;font-weight:750}.step-value view{color:#aaa9ad;font-size:18rpx}.actions{gap:24rpx;margin-top:54rpx}.share-button,.finish-button{flex:1;margin:0;padding:20rpx 12rpx;border-radius:42rpx;font-size:23rpx;font-weight:650}.share-button{border:3rpx solid #747cff;background:transparent;color:#747cff}.finish-button{background:#747cff;color:#fff}
